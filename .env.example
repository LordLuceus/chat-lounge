# Database
DATABASE_URL="mysql://user:password@localhost:3306/chat_lounge"

# Users' provider API keys are encrypted at rest with this secret (32 random
# bytes as base64 or hex). Generate with: openssl rand -base64 32
# Keep it with your backups: without it stored API keys cannot be decrypted.
